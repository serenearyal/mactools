<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.serenearyal.mactools.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/MacToolsHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.serenearyal.mactools.helper</key>
		<true/>
	</dict>
	<!-- The helper has to run at boot, not only when a client asks for the
	     mach service: SleepDisabled survives a reboot, and the recovery that
	     clears a flag a previous run left behind is at the start of this
	     daemon. Without RunAtLoad a Mac that was killed holding the flag would
	     stay unable to sleep until somebody opened MacTools. Idle cost is nil: the
	     process waits on its listener and polls nothing. -->
	<key>RunAtLoad</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.serenearyal.mactools</string>
	</array>
</dict>
</plist>
