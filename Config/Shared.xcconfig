// Shared build settings for every MacTools target.
// Machine-specific overrides go in Config/local.xcconfig, which is gitignored
// and included at the end of this file, so what it sets wins. To build with
// another Apple ID, put your own team and identity there:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_IDENTITY = Apple Development
//   CODE_SIGN_IDENTITY[config=Release] = Apple Development
//
// The Release line is needed because a conditional setting beats a plain one.

DEVELOPMENT_TEAM = M9Q5YCJ5NU
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Manual signing. Debug builds use the Apple Development identity; Release
// builds, which are what ships in the DMG, use Developer ID so that
// Gatekeeper accepts them on other Macs once they are notarized (`make
// notarize`). A macOS app that is not sandboxed and claims no restricted
// entitlement needs no provisioning profile.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[config=Release] = Developer ID Application
PROVISIONING_PROFILE_SPECIFIER =

// `xcodebuild build` (what the Makefile runs) signs like a debug build unless
// told otherwise: it injects `get-task-allow`, so a debugger can attach, and
// it skips the secure timestamp. The notary service rejects both. An archive
// would set these itself; the Release config sets them here instead.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
OTHER_CODE_SIGN_FLAGS[config=Release] = --timestamp

ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES

ONLY_ACTIVE_ARCH = YES
DEAD_CODE_STRIPPING = YES
CLANG_ENABLE_OBJC_ARC = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
GCC_TREAT_WARNINGS_AS_ERRORS = NO

#include? "local.xcconfig"
